# Cowork server environment variables
# Copy to server/.env and fill in real values

# Database — matches docker-compose.yml db service
DATABASE_URL=postgres://mth:mth@localhost:5432/mth

# Server port
PORT=3100

# Don't serve the bundled UI (run ui/ separately with npm run dev)
SERVE_UI=false

# Required for better-auth session signing (generate with: openssl rand -hex 32)
BETTER_AUTH_SECRET=your_secret_here

# Deployment mode (local dev)
MTH_DEPLOYMENT_MODE=local
