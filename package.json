{
  "name": "meowtieheightgent",
  "private": true,
  "type": "module",
  "scripts": {
    "dev:server": "pnpm --filter @meowtieheightgent/server dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test:run": "pnpm -r test:run",
    "db:generate": "pnpm --filter @meowtieheightgent/db generate",
